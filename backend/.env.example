# Copy this file to .env and fill in real values. .env is git-ignored.

# Local PostgreSQL 18 (already installed on this machine).
# Create the database first: run `CREATE DATABASE takaflow;` as the postgres
# user (via pgAdmin or psql), then fill in the password you set for that user.
DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD_HERE@localhost:5432/takaflow

# Generate a real secret before running anything beyond local dev, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=dev-only-change-me

ENVIRONMENT=development
